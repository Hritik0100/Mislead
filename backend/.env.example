DATABASE_URL=sqlite:///./data/osint.db
REDIS_URL=redis://localhost:6379/0
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
S3_ENDPOINT=local
S3_BUCKET=osint-evidence
EVIDENCE_DIR=./data/evidence
APP_SECRET_KEY=change-me-dev-only
API_HOST=0.0.0.0
API_PORT=8000

# OPTIONAL authenticated browser collection (investigator-owned accounts ONLY).
# One pair per platform prefix, e.g. OUTLET_USERNAME / OUTLET_PASSWORD.
# Never commit real credentials. Passwords are never logged, stored, or sent to the LLM.
# PLATFORM_USERNAME=
# PLATFORM_PASSWORD=
# PLATFORM_LOGIN_URL=
# X session cookies (exported from investigator's own browser, JSON array).
# X_COOKIES_JSON=

# TELEGRAM — real MTProto collector (pip install telethon).
# App credentials: https://my.telegram.org -> API development tools.
# Then create the session ONCE from your terminal (asks for the login code and
# any 2FA password on your TTY; neither is ever logged or stored in the repo):
#   python -m app.services.collectors.telegram login
# Collections then reuse that 0600 session file silently. Only the
# investigator's own account and the content it can legitimately see.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=            # E.164, only needed for the login command
# TELEGRAM_2FA_PASSWORD=     # as sensitive as a password; keep it out of git
# TELEGRAM_SESSION=          # StringSession for CI/headless (no code entry)
