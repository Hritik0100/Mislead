DATABASE_URL=sqlite:///./data/osint.db
REDIS_URL=redis://localhost:6379/0
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
S3_ENDPOINT=local
S3_BUCKET=osint-evidence
EVIDENCE_DIR=./data/evidence
APP_SECRET_KEY=change-me-dev-only
API_HOST=0.0.0.0
API_PORT=8000

# OPTIONAL authenticated browser collection (investigator-owned accounts ONLY).
# One pair per platform prefix, e.g. OUTLET_USERNAME / OUTLET_PASSWORD.
# Never commit real credentials. Passwords are never logged, stored, or sent to the LLM.
# PLATFORM_USERNAME=
# PLATFORM_PASSWORD=
# PLATFORM_LOGIN_URL=
# X session cookies (exported from investigator's own browser, JSON array).
# X_COOKIES_JSON=
